# Copy this file to `.env` and fill it in.

PORT=3000

# Shared secret the separate admin app authenticates with.
# Until this is set the internal API is disabled and the admin panel cannot connect.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Paste the SAME value into the admin app's .env.
STORE_API_KEY=

# Optional: also push every new order straight into your Telegram.
# 1. Create a bot with @BotFather and paste the token below.
# 2. Send your bot a message, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Set to "production" when deploying behind HTTPS.
NODE_ENV=development
