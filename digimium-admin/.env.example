# Copy this file to `.env` and fill it in.

PORT=4000

# Where the storefront lives. Use the public https URL once deployed.
STORE_URL=https://your-store-domain.com

# Must match STORE_API_KEY in the store app's .env exactly.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STORE_API_KEY=

# Keeps you signed in across restarts. Any long random string.
SESSION_SECRET=

# Your login passcode — a PIN (digits) or a password. At least 6 characters.
# Only used the first time; after that change it on the Account tab.
ADMIN_PASSCODE=

# Set to "production" when deploying behind HTTPS (makes the session cookie secure).
NODE_ENV=development
